{
  "info": {
    "name": "318 E-Commerce - End-to-End Walkthrough (auto-chained)",
    "description": "Mirrors scripts/e2e-walkthrough.mjs. All chaining (tokens, ids, amounts) uses Collection Variables via pm.collectionVariables.set, so this works with any Environment selected (including 'No Environment').",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "userBase", "value": "http://localhost:8081/api/v1" },
    { "key": "productBase", "value": "http://localhost:8082/api/v1" },
    { "key": "orderBase", "value": "http://localhost:8083/api/v1" },
    { "key": "inventoryBase", "value": "http://localhost:8084/api/v1" },
    { "key": "paymentBase", "value": "http://localhost:8085/api/v1" },
    { "key": "adminEmail", "value": "admin@318ecommerce.local" },
    { "key": "adminPassword", "value": "ChangeMe123!" },
    { "key": "adminToken", "value": "" },
    { "key": "customerEmail", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "orderAmount", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "order2Id", "value": "" },
    { "key": "order2Amount", "value": "" },
    { "key": "payment2Id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login as Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": { "raw": "{{userBase}}/users/login", "host": ["{{userBase}}"], "path": ["users", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeded', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('adminToken', jsonData.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create a Product (P4, admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"E2E Test Widget\",\n  \"description\": \"Created via Postman collection\",\n  \"price\": { \"amount\": 20.00, \"currency\": \"AUD\" },\n  \"imageUrl\": \"https://example.com/widget.jpg\",\n  \"categoryId\": \"CAT-TEST\"\n}"
        },
        "url": { "raw": "{{productBase}}/products", "host": ["{{productBase}}"], "path": ["products"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('product created', function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('productId', jsonData.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Give it Stock (I3, admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"delta\": 50,\n  \"reason\": \"Initial stock\"\n}"
        },
        "url": {
          "raw": "{{inventoryBase}}/inventory/{{productId}}/adjust",
          "host": ["{{inventoryBase}}"],
          "path": ["inventory", "{{productId}}", "adjust"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('stock adjusted', function () { pm.response.to.have.status(200); });",
              "pm.test('quantity is 50', function () { pm.expect(pm.response.json().quantityAvailable).to.eql(50); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Check Stock (I1, no auth)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{inventoryBase}}/inventory/{{productId}}",
          "host": ["{{inventoryBase}}"],
          "path": ["inventory", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('stock visible', function () { pm.response.to.have.status(200); });",
              "pm.test('quantity is 50', function () { pm.expect(pm.response.json().quantityAvailable).to.eql(50); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Register a Customer (U1)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Passw0rd!\"\n}"
        },
        "url": { "raw": "{{userBase}}/users/register", "host": ["{{userBase}}"], "path": ["users", "register"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('customerEmail', 'e2e.customer.' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('customer registered', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Login as Customer (U2)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Passw0rd!\"\n}"
        },
        "url": { "raw": "{{userBase}}/users/login", "host": ["{{userBase}}"], "path": ["users", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeded', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('customerToken', jsonData.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Browse Products (P1, no auth)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{productBase}}/products?page=0&size=20",
          "host": ["{{productBase}}"],
          "path": ["products"],
          "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('products listed', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Place an Order (O1)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [ { \"productId\": \"{{productId}}\", \"quantity\": 2 } ]\n}"
        },
        "url": { "raw": "{{orderBase}}/orders", "host": ["{{orderBase}}"], "path": ["orders"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('order created', function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "pm.test('order pending', function () { pm.expect(jsonData.status).to.eql('PENDING'); });",
              "pm.collectionVariables.set('orderId', jsonData.id);",
              "pm.collectionVariables.set('orderAmount', JSON.stringify(jsonData.totalAmount));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Check Stock After Order (I1, expect reduced)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{inventoryBase}}/inventory/{{productId}}",
          "host": ["{{inventoryBase}}"],
          "path": ["inventory", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('quantity is 48', function () { pm.expect(pm.response.json().quantityAvailable).to.eql(48); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Pay for the Order (PAY1)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": {{orderAmount}}\n}"
        },
        "url": { "raw": "{{paymentBase}}/payments", "host": ["{{paymentBase}}"], "path": ["payments"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('payment created', function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('paymentId', jsonData.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Check Order After Payment (O2, expect PAID)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
        "url": {
          "raw": "{{orderBase}}/orders/{{orderId}}",
          "host": ["{{orderBase}}"],
          "path": ["orders", "{{orderId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('order paid', function () { pm.expect(pm.response.json().status).to.eql('PAID'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Check Payment by Order (PAY2)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
        "url": {
          "raw": "{{paymentBase}}/payments/order/{{orderId}}",
          "host": ["{{paymentBase}}"],
          "path": ["payments", "order", "{{orderId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('payment found', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Admin: List All Transactions (PAY4)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{paymentBase}}/payments?page=0&size=50",
          "host": ["{{paymentBase}}"],
          "path": ["payments"],
          "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "50" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('transactions listed', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Place a Second Order (for cancel/refund)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [ { \"productId\": \"{{productId}}\", \"quantity\": 1 } ]\n}"
        },
        "url": { "raw": "{{orderBase}}/orders", "host": ["{{orderBase}}"], "path": ["orders"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('order created', function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('order2Id', jsonData.id);",
              "pm.collectionVariables.set('order2Amount', JSON.stringify(jsonData.totalAmount));"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Pay for Second Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{order2Id}}\",\n  \"amount\": {{order2Amount}}\n}"
        },
        "url": { "raw": "{{paymentBase}}/payments", "host": ["{{paymentBase}}"], "path": ["payments"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('payment created', function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('payment2Id', jsonData.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Cancel Second Order (O4)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
        "url": {
          "raw": "{{orderBase}}/orders/{{order2Id}}/cancel",
          "host": ["{{orderBase}}"],
          "path": ["orders", "{{order2Id}}", "cancel"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('order cancelled', function () { pm.expect(pm.response.json().status).to.eql('CANCELLED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Request Refund (PAY3)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Customer requested cancellation\"\n}"
        },
        "url": {
          "raw": "{{paymentBase}}/payments/{{payment2Id}}/refund",
          "host": ["{{paymentBase}}"],
          "path": ["payments", "{{payment2Id}}", "refund"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refund created', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    }
  ]
}
